<?xml version="1.0"?>
<robot name="denso_vs6556" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Arguments -->
  <xacro:arg name="controllers_file" default="$(find denso_gazebo)/config/denso_controllers.yaml"/>

  <!-- World link -->
  <link name="world"/>

  <!-- Fixed joint: world to base -->
  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- base_link (c001) -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0.09" rpy="0 0 0"/>
      <mass value="8.0"/>
      <inertia ixx="0.04" ixy="0.0" ixz="0.0" iyy="0.04" iyz="0.0" izz="0.05"/>
    </inertial>
    <visual>
      <origin xyz="-0.11555 0.11564 0.0" rpy="1.570796 0 0"/>
      <geometry>
        <mesh filename="package://denso_vs6556/meshes/410590-0080-c001.STL" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="denso_gray">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="-0.11555 0.11564 0.0" rpy="1.570796 0 0"/>
      <geometry>
        <mesh filename="package://denso_vs6556/meshes/410590-0080-c001.STL" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <!-- link_1 (c002, shoulder) -->
  <link name="link_1">
    <inertial>
      <origin xyz="-0.04 0.0 0.08" rpy="0 0 0"/>
      <mass value="4.5"/>
      <inertia ixx="0.035" ixy="0.0" ixz="0.0" iyy="0.035" iyz="0.0" izz="0.025"/>
    </inertial>
    <visual>
      <origin xyz="-0.160 0.110 0.0" rpy="1.570796 0 0"/>
      <geometry>
        <mesh filename="package://denso_vs6556/meshes/410590-0080-c002.STL" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="denso_blue">
        <color rgba="0.15 0.25 0.55 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="-0.160 0.110 0.0" rpy="1.570796 0 0"/>
      <geometry>
        <mesh filename="package://denso_vs6556/meshes/410590-0080-c002.STL" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <!-- link_2 (c003, upper arm) -->
  <link name="link_2">
    <inertial>
      <origin xyz="0.0 0.003 0.135" rpy="0 0 0"/>
      <mass value="4.2"/>
      <inertia ixx="0.045" ixy="0.0" ixz="0.0" iyy="0.040" iyz="0.0" izz="0.015"/>
    </inertial>
    <visual>
      <origin xyz="-0.08719 0.0055 -0.08557" rpy="1.570796 0 0"/>
      <geometry>
        <mesh filename="package://denso_vs6556/meshes/410590-0080-c003.STL" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="denso_white">
        <color rgba="0.85 0.85 0.85 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="-0.08719 0.0055 -0.08557" rpy="1.570796 0 0"/>
      <geometry>
        <mesh filename="package://denso_vs6556/meshes/410590-0080-c003.STL" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <!-- link_3 (c004, elbow) -->
  <link name="link_3">
    <inertial>
      <origin xyz="-0.04 0.02 0.04" rpy="0 0 0"/>
      <mass value="3.1"/>
      <inertia ixx="0.020" ixy="0.0" ixz="0.0" iyy="0.020" iyz="0.0" izz="0.010"/>
    </inertial>
    <visual>
      <origin xyz="-0.10802 0.13900 -0.07250" rpy="1.570796 0 0"/>
      <geometry>
        <mesh filename="package://denso_vs6556/meshes/410590-0080-c004.STL" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="denso_white2">
        <color rgba="0.85 0.85 0.85 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="-0.10802 0.13900 -0.07250" rpy="1.570796 0 0"/>
      <geometry>
        <mesh filename="package://denso_vs6556/meshes/410590-0080-c004.STL" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <!-- link_4 (c005, forearm) -->
  <link name="link_4">
    <inertial>
      <origin xyz="-0.10 0.0 0.0" rpy="0 0 0"/>
      <mass value="2.0"/>
      <inertia ixx="0.005" ixy="0.0" ixz="0.0" iyy="0.015" iyz="0.0" izz="0.015"/>
    </inertial>
    <visual>
      <origin xyz="-0.2545 0.0670 -0.0566" rpy="1.570796 0 0"/>
      <geometry>
        <mesh filename="package://denso_vs6556/meshes/410590-0080-c005.STL" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="denso_gray2">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="-0.2545 0.0670 -0.0566" rpy="1.570796 0 0"/>
      <geometry>
        <mesh filename="package://denso_vs6556/meshes/410590-0080-c005.STL" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <!-- link_5 (c006, tool flange) -->
  <link name="link_5">
    <inertial>
      <origin xyz="-0.03 0.0 0.0" rpy="0 0 0"/>
      <mass value="1.2"/>
      <inertia ixx="0.003" ixy="0.0" ixz="0.0" iyy="0.003" iyz="0.0" izz="0.003"/>
    </inertial>
    <visual>
      <origin xyz="-0.08304 0.03242 -0.04093" rpy="1.570796 0 0"/>
      <geometry>
        <mesh filename="package://denso_vs6556/meshes/410590-0080-c006.STL" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="denso_dark">
        <color rgba="0.3 0.3 0.3 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="-0.08304 0.03242 -0.04093" rpy="1.570796 0 0"/>
      <geometry>
        <mesh filename="package://denso_vs6556/meshes/410590-0080-c006.STL" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <!-- joint_1: base_link -> link_1 (shoulder yaw, Z axis) -->
  <joint name="joint_1" type="revolute">
    <parent link="base_link"/>
    <child link="link_1"/>
    <origin xyz="0 0 0.185" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.96706" upper="2.96706" effort="80" velocity="4.5815"/>
    <dynamics damping="0.8" friction="0.5"/>
  </joint>

  <!-- joint_2: link_1 -> link_2 (shoulder pitch, Y axis) -->
  <joint name="joint_2" type="revolute">
    <parent link="link_1"/>
    <child link="link_2"/>
    <origin xyz="-0.075 -0.0545 0.150" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.094395" upper="2.356194" effort="100" velocity="4.1888"/>
    <dynamics damping="1.2" friction="0.8"/>
  </joint>

  <!-- joint_3: link_2 -> link_3 (elbow pitch, Y axis) -->
  <joint name="joint_3" type="revolute">
    <parent link="link_2"/>
    <child link="link_3"/>
    <origin xyz="0 0.0055 0.270" rpy="0 1.5707963 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.076942" upper="2.897247" effort="60" velocity="5.2360"/>
    <dynamics damping="0.9" friction="0.6"/>
  </joint>

  <!-- joint_4: link_3 -> link_4 (forearm roll) -->
  <joint name="joint_4" type="revolute">
    <parent link="link_3"/>
    <child link="link_4"/>
    <origin xyz="-0.088 0.049 0.090" rpy="3.1415926 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-3.316126" upper="3.316126" effort="25" velocity="5.2360"/>
    <dynamics damping="0.3" friction="0.2"/>
  </joint>

  <!-- joint_5: link_4 -> link_5 (wrist pitch, rotation in XZ plane, Y axis) -->
  <joint name="joint_5" type="revolute">
    <parent link="link_4"/>
    <child link="link_5"/>
    <origin xyz="-0.207 0 0" rpy="3.1415926 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.094395" upper="2.094395" effort="20" velocity="5.2360"/>
    <dynamics damping="0.2" friction="0.15"/>
  </joint>

  <!-- Gazebo Visual Materials -->
  <gazebo reference="base_link">
    <visual>
      <material>
        <ambient>0.5 0.5 0.5 1.0</ambient>
        <diffuse>0.5 0.5 0.5 1.0</diffuse>
        <specular>0.2 0.2 0.2 1.0</specular>
      </material>
    </visual>
  </gazebo>

  <gazebo reference="link_1">
    <visual>
      <material>
        <ambient>0.15 0.25 0.55 1.0</ambient>
        <diffuse>0.15 0.25 0.55 1.0</diffuse>
        <specular>0.3 0.3 0.3 1.0</specular>
      </material>
    </visual>
  </gazebo>

  <gazebo reference="link_2">
    <visual>
      <material>
        <ambient>0.85 0.85 0.85 1.0</ambient>
        <diffuse>0.85 0.85 0.85 1.0</diffuse>
        <specular>0.3 0.3 0.3 1.0</specular>
      </material>
    </visual>
  </gazebo>

  <gazebo reference="link_3">
    <visual>
      <material>
        <ambient>0.85 0.85 0.85 1.0</ambient>
        <diffuse>0.85 0.85 0.85 1.0</diffuse>
        <specular>0.3 0.3 0.3 1.0</specular>
      </material>
    </visual>
  </gazebo>

  <gazebo reference="link_4">
    <visual>
      <material>
        <ambient>0.5 0.5 0.5 1.0</ambient>
        <diffuse>0.5 0.5 0.5 1.0</diffuse>
        <specular>0.2 0.2 0.2 1.0</specular>
      </material>
    </visual>
  </gazebo>

  <gazebo reference="link_5">
    <visual>
      <material>
        <ambient>0.3 0.3 0.3 1.0</ambient>
        <diffuse>0.3 0.3 0.3 1.0</diffuse>
        <specular>0.2 0.2 0.2 1.0</specular>
      </material>
    </visual>
  </gazebo>

  <!-- ros2_control Hardware Interface -->
  <ros2_control name="GazeboSimSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      <param name="hold_joints">true</param>
    </hardware>
    <joint name="joint_1">
      <command_interface name="position">
        <param name="min">-2.96706</param>
        <param name="max">2.96706</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="joint_2">
      <command_interface name="position">
        <param name="min">-2.094395</param>
        <param name="max">2.356194</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="joint_3">
      <command_interface name="position">
        <param name="min">-2.076942</param>
        <param name="max">2.897247</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="joint_4">
      <command_interface name="position">
        <param name="min">-3.316126</param>
        <param name="max">3.316126</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="joint_5">
      <command_interface name="position">
        <param name="min">-2.094395</param>
        <param name="max">2.094395</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </ros2_control>

  <!-- Gazebo ROS 2 Control Plugin -->
  <gazebo>
    <plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(arg controllers_file)</parameters>
      <position_proportional_gain>0.5</position_proportional_gain>
    </plugin>
  </gazebo>

</robot>

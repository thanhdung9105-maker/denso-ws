<?xml version="1.0"?>
<robot name="denso_vs6556" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Arguments -->
  <xacro:arg name="controllers_file" default="$(find denso_gazebo)/config/denso_controllers.yaml"/>

  <!-- base_link (c001) -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0.09" rpy="0 0 0"/>
      <mass value="8.0"/>
      <inertia ixx="0.04" ixy="0.0" ixz="0.0" iyy="0.04" iyz="0.0" izz="0.05"/>
    </inertial>
    <visual>
      <origin xyz="-0.11555 0.11564 0.0" rpy="1.570796 0 0"/>
      <geometry>
        <mesh filename="package://denso_vs6556/meshes/410590-0080-c001.STL" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="denso_gray">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="-0.11555 0.11564 0.0" rpy="1.570796 0 0"/>
      <geometry>
        <mesh filename="package://denso_vs6556/meshes/410590-0080-c001.STL" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <!-- link_1 (c002, shoulder) -->
  <link name="link_1">
    <inertial>
      <origin xyz="-0.04 0.0 0.08" rpy="0 0 0"/>
      <mass value="4.5"/>
      <inertia ixx="0.035" ixy="0.0" ixz="0.0" iyy="0.035" iyz="0.0" izz="0.025"/>
    </inertial>
    <visual>
      <origin xyz="-0.16000 0.11000 -0.02000" rpy="1.570796 0 0"/>
      <geometry>
        <mesh filename="package://denso_vs6556/meshes/410590-0080-c002.STL" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="denso_blue">
        <color rgba="0.15 0.25 0.55 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="-0.16000 0.11000 -0.02000" rpy="1.570796 0 0"/>
      <geometry>
        <mesh filename="package://denso_vs6556/meshes/410590-0080-c002.STL" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <!-- link_2 (c003, upper arm) -->
  <link name="link_2">
    <inertial>
      <origin xyz="0.0 -0.041 0.120" rpy="0 0 0"/>
      <mass value="4.2"/>
      <inertia ixx="0.045" ixy="0.0" ixz="0.0" iyy="0.040" iyz="0.0" izz="0.015"/>
    </inertial>
    <visual>
      <origin xyz="-0.08719 0.02550 -0.08557" rpy="1.570796 0 0"/>
      <geometry>
        <mesh filename="package://denso_vs6556/meshes/410590-0080-c003.STL" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="denso_white">
        <color rgba="0.85 0.85 0.85 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="-0.08719 0.02550 -0.08557" rpy="1.570796 0 0"/>
      <geometry>
        <mesh filename="package://denso_vs6556/meshes/410590-0080-c003.STL" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <!-- link_3 (c004, elbow) -->
  <link name="link_3">
    <inertial>
      <origin xyz="0.045 0.075 0.010" rpy="0 0 0"/>
      <mass value="3.1"/>
      <inertia ixx="0.020" ixy="0.0" ixz="0.0" iyy="0.020" iyz="0.0" izz="0.010"/>
    </inertial>
    <visual>
      <!-- Aligned with joint_3 elbow pitch axis matching SolidWorks VS-6556-B_asm.STL -->
      <origin xyz="-0.07250 0.15800 0.10802" rpy="1.570796 1.570796 0"/>
      <geometry>
        <mesh filename="package://denso_vs6556/meshes/410590-0080-c004.STL" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="denso_white2">
        <color rgba="0.85 0.85 0.85 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="-0.07250 0.15800 0.10802" rpy="1.570796 1.570796 0"/>
      <geometry>
        <mesh filename="package://denso_vs6556/meshes/410590-0080-c004.STL" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <!-- link_4 (c005, forearm) -->
  <link name="link_4">
    <inertial>
      <origin xyz="0 0 0.10" rpy="0 0 0"/>
      <mass value="2.0"/>
      <inertia ixx="0.015" ixy="0.0" ixz="0.0" iyy="0.015" iyz="0.0" izz="0.005"/>
    </inertial>
    <visual>
      <!-- Aligned with forearm roll axis matching SolidWorks VS-6556-B_asm.STL -->
      <origin xyz="0.05660 -0.06700 0.23350" rpy="-1.570796 1.570796 0"/>
      <geometry>
        <mesh filename="package://denso_vs6556/meshes/410590-0080-c005.STL" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="denso_gray2">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.05660 -0.06700 0.23350" rpy="-1.570796 1.570796 0"/>
      <geometry>
        <mesh filename="package://denso_vs6556/meshes/410590-0080-c005.STL" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <!-- link_5 (c006, wrist knuckle / pitch) -->
  <link name="link_5">
    <inertial>
      <origin xyz="0.0 0.0 0.0163" rpy="0 0 0"/>
      <mass value="0.95"/>
      <inertia ixx="0.000816" ixy="0.0" ixz="0.0" iyy="0.000954" iyz="0.0" izz="0.000634"/>
    </inertial>
    <visual>
      <!-- Origin set at wrist pitch axis matching SolidWorks VS-6556-B_asm.STL -->
      <origin xyz="-0.04093 0.03242 0.06204" rpy="1.570796 1.570796 0"/>
      <geometry>
        <mesh filename="package://denso_vs6556/meshes/410590-0080-c006.STL" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="denso_dark">
        <color rgba="0.3 0.3 0.3 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="-0.04093 0.03242 0.06204" rpy="1.570796 1.570796 0"/>
      <geometry>
        <mesh filename="package://denso_vs6556/meshes/410590-0080-c006.STL" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <!-- link_6 (c007, tool flange / wrist roll) -->
  <link name="link_6">
    <inertial>
      <origin xyz="0.0 0.0 0.01126" rpy="0 0 0"/>
      <mass value="0.25"/>
      <inertia ixx="0.000072" ixy="0.0" ixz="0.0" iyy="0.000072" iyz="0.0" izz="0.000120"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://denso_vs6556/meshes/410590-0080-c006_flange.STL" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="denso_gray1">
        <color rgba="0.25 0.25 0.25 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.014" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.0325" length="0.028"/>
      </geometry>
    </collision>
  </link>

  <!-- joint_1: base_link -> link_1 (shoulder yaw, Z axis) -->
  <joint name="joint_1" type="revolute">
    <parent link="base_link"/>
    <child link="link_1"/>
    <origin xyz="0 0 0.205" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.96706" upper="2.96706" effort="80" velocity="4.5815"/>
    <dynamics damping="1.0" friction="0.0"/>
  </joint>

  <!-- joint_2: link_1 -> link_2 (shoulder pitch, Y axis) -->
  <joint name="joint_2" type="revolute">
    <parent link="link_1"/>
    <child link="link_2"/>
    <origin xyz="-0.075 -0.0745 0.130" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-2.094395" upper="2.356194" effort="100" velocity="4.1888"/>
    <dynamics damping="1.5" friction="0.0"/>
  </joint>

  <!-- joint_3: link_2 -> link_3 (elbow pitch, Y axis) -->
  <joint name="joint_3" type="revolute">
    <parent link="link_2"/>
    <child link="link_3"/>
    <origin xyz="0 0.0065 0.270" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-2.076942" upper="2.897247" effort="60" velocity="5.2360"/>
    <dynamics damping="1.0" friction="0.0"/>
  </joint>

  <!-- joint_4: link_3 -> link_4 (forearm roll, Z axis) -->
  <joint name="joint_4" type="revolute">
    <parent link="link_3"/>
    <child link="link_4"/>
    <origin xyz="0.090 0.068 0.109" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.316126" upper="3.316126" effort="25" velocity="5.2360"/>
    <dynamics damping="0.5" friction="0.0"/>
  </joint>

  <!-- joint_5: link_4 -> link_5 (wrist pitch, Y axis) -->
  <joint name="joint_5" type="revolute">
    <parent link="link_4"/>
    <child link="link_5"/>
    <origin xyz="0 0 0.186" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-2.094395" upper="2.094395" effort="20" velocity="5.2360"/>
    <dynamics damping="0.5" friction="0.0"/>
  </joint>

  <!-- joint_6: link_5 -> link_6 (wrist roll / flange twist, Z axis) -->
  <joint name="joint_6" type="revolute">
    <parent link="link_5"/>
    <child link="link_6"/>
    <origin xyz="0 0 0.06204" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.283185" upper="6.283185" effort="15" velocity="7.3304"/>
    <dynamics damping="0.2" friction="0.0"/>
  </joint>

  <!-- Gazebo Visual Materials -->
  <gazebo reference="base_link">
    <visual>
      <material>
        <ambient>0.5 0.5 0.5 1.0</ambient>
        <diffuse>0.5 0.5 0.5 1.0</diffuse>
        <specular>0.2 0.2 0.2 1.0</specular>
      </material>
    </visual>
  </gazebo>

  <gazebo reference="link_1">
    <visual>
      <material>
        <ambient>0.15 0.25 0.55 1.0</ambient>
        <diffuse>0.15 0.25 0.55 1.0</diffuse>
        <specular>0.3 0.3 0.3 1.0</specular>
      </material>
    </visual>
  </gazebo>

  <gazebo reference="link_2">
    <visual>
      <material>
        <ambient>0.85 0.85 0.85 1.0</ambient>
        <diffuse>0.85 0.85 0.85 1.0</diffuse>
        <specular>0.3 0.3 0.3 1.0</specular>
      </material>
    </visual>
  </gazebo>

  <gazebo reference="link_3">
    <visual>
      <material>
        <ambient>0.85 0.85 0.85 1.0</ambient>
        <diffuse>0.85 0.85 0.85 1.0</diffuse>
        <specular>0.3 0.3 0.3 1.0</specular>
      </material>
    </visual>
  </gazebo>

  <gazebo reference="link_4">
    <visual>
      <material>
        <ambient>0.5 0.5 0.5 1.0</ambient>
        <diffuse>0.5 0.5 0.5 1.0</diffuse>
        <specular>0.2 0.2 0.2 1.0</specular>
      </material>
    </visual>
  </gazebo>

  <gazebo reference="link_5">
    <visual>
      <material>
        <ambient>0.3 0.3 0.3 1.0</ambient>
        <diffuse>0.3 0.3 0.3 1.0</diffuse>
        <specular>0.2 0.2 0.2 1.0</specular>
      </material>
    </visual>
  </gazebo>

  <gazebo reference="link_6">
    <visual>
      <material>
        <ambient>0.25 0.25 0.25 1.0</ambient>
        <diffuse>0.25 0.25 0.25 1.0</diffuse>
        <specular>0.3 0.3 0.3 1.0</specular>
      </material>
    </visual>
  </gazebo>

  <!-- ros2_control Hardware Interface -->
  <ros2_control name="GazeboSimSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      <param name="hold_joints">true</param>
    </hardware>
    <joint name="joint_1">
      <command_interface name="position">
        <param name="min">-2.96706</param>
        <param name="max">2.96706</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="joint_2">
      <command_interface name="position">
        <param name="min">-2.094395</param>
        <param name="max">2.356194</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="joint_3">
      <command_interface name="position">
        <param name="min">-2.076942</param>
        <param name="max">2.897247</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="joint_4">
      <command_interface name="position">
        <param name="min">-3.316126</param>
        <param name="max">3.316126</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="joint_5">
      <command_interface name="position">
        <param name="min">-2.094395</param>
        <param name="max">2.094395</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="joint_6">
      <command_interface name="position">
        <param name="min">-6.283185</param>
        <param name="max">6.283185</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </ros2_control>

  <!-- Gazebo ROS 2 Control Plugin -->
  <gazebo>
    <plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(arg controllers_file)</parameters>
      <position_proportional_gain>0.1</position_proportional_gain>
    </plugin>
  </gazebo>


  <!-- Gazebo anchor for base_link (keeps robot fixed in Gazebo without adding world frame to ROS TF) -->
  <gazebo>
    <joint name="world_to_base" type="fixed">
      <parent>world</parent>
      <child>base_link</child>
    </joint>
  </gazebo>


  <!-- ======================================================== -->
  <!-- HIGH-PRECISION ROBOTIC COMPACT STYLUS TOOL               -->
  <!-- ======================================================== -->
  <link name="pen_tool_link">
    <!-- Flange Mounting Collar -->
    <visual>
      <origin xyz="0 0 0.0025" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.006" length="0.005"/>
      </geometry>
      <material name="pen_adapter">
        <color rgba="0.18 0.22 0.30 1.0"/>
      </material>
    </visual>
    <!-- Compact Stylus Body / Barrel -->
    <visual>
      <origin xyz="0 0 0.0085" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.0035" length="0.007"/>
      </geometry>
      <material name="pen_barrel">
        <color rgba="0.12 0.20 0.35 1.0"/>
      </material>
    </visual>
    <!-- Stylus Nib (15mm Tip) -->
    <visual>
      <origin xyz="0 0 0.014" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.0025"/>
      </geometry>
      <material name="pen_nib">
        <color rgba="0.10 0.30 0.60 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.008" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.006" length="0.016"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.008" rpy="0 0 0"/>
      <mass value="0.015"/>
      <inertia ixx="0.000001" ixy="0.0" ixz="0.0" iyy="0.000001" iyz="0.0" izz="0.0000005"/>
    </inertial>
  </link>

  <joint name="joint_pen_tool" type="fixed">
    <parent link="link_6"/>
    <child link="pen_tool_link"/>
    <origin xyz="0 0 0.028" rpy="0 0 0"/>
  </joint>

  <gazebo reference="pen_tool_link">
    <visual>
      <material>
        <ambient>0.12 0.20 0.35 1.0</ambient>
        <diffuse>0.15 0.25 0.45 1.0</diffuse>
        <specular>0.4 0.4 0.4 1.0</specular>
      </material>
    </visual>
  </gazebo>

</robot>

Panels:
- Class: rviz_common/Displays
  Help Height: 78
  Name: Displays
  Property Tree Widget:
    Expanded:
    - /Global Options1
    - /Link Centers of Mass & Masses (Trọng tâm & Khối lượng)1
    - /Link Centers of Mass & Masses (Trọng tâm & Khối lượng)1/Namespaces1
    Splitter Ratio: 0.5
  Tree Height: 480
- Class: rviz_common/Views
  Expanded:
  - /Current View1
  Name: Views
  Splitter Ratio: 0.5
Visualization Manager:
  Class: ''
  Displays:
  - Alpha: 0.5
    Cell Size: 0.1
    Class: rviz_default_plugins/Grid
    Color: 160; 160; 164
    Enabled: true
    Line Style:
      Line Width: 0.03
      Value: Lines
    Name: Grid
    Normal Cell Count: 0
    Offset:
      X: 0
      Y: 0
      Z: 0
    Plane: XY
    Plane Cell Count: 10
    Reference Frame: world
    Value: true
  - Alpha: 0.55
    Class: rviz_default_plugins/RobotModel
    Collision Enabled: false
    Description File: ''
    Description Source: Topic
    Description Topic:
      Depth: 5
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /robot_description
    Enabled: true
    Links:
      All Links Enabled: true
    Name: RobotModel
    TF Prefix: ''
    Update Interval: 0
    Value: true
    Visual Enabled: true
  - Class: rviz_default_plugins/TF
    Enabled: false
    Filter (blacklist): ''
    Filter (whitelist): ''
    Frame Timeout: 15
    Frames:
      All Enabled: true
    Marker Scale: 0.5
    Name: TF
    Show Arrows: true
    Show Axes: true
    Show Names: false
    Tree: {}
    Update Interval: 0
    Value: true
  - Class: rviz_default_plugins/MarkerArray
    Enabled: true
    Name: Link Centers of Mass & Masses (Trọng tâm & Khối lượng)
    Namespaces:
      1. Điểm Trọng tâm (Xanh Neon): true
      2. Khung ngắm Hồng tâm (Vòng Trắng): true
      3. Hệ trục tọa độ 3D (X-Y-Z): true
      4. Đường chỉ dẫn ra ngoài: true
      5. Nhãn khối lượng & Trọng tâm: true
      Part 0 - Base (Đế) (8.0 kg): true
      Part 1 - Link 1 (4.5 kg): true
      Part 2 - Link 2 (Bắp tay) (4.2 kg): true
      Part 3 - Link 3 (Khuỷu) (3.1 kg): true
      Part 4 - Link 4 (Cánh tay) (2.0 kg): true
      Part 5 - Link 5 (Cổ tay) (0.95 kg): true
      Part 6 - Link 6 (Nắp bích xoay) (0.25 kg): true
    Topic:
      Depth: 10
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /denso/com_markers
    Value: true
  - Class: rviz_default_plugins/MarkerArray
    Enabled: true
    Name: Denso Drawing Trail (Vệt Vẽ Cánh Tay)
    Namespaces:
      drawing_trail: true
    Topic:
      Depth: 10
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /denso/drawing_trail
    Value: true
  - Class: moveit_rviz_plugin/MotionPlanning
    Enabled: true
    Move Group Namespace: ''
    Name: MotionPlanning
    Planning Metrics:
      Show Joint Torques: false
      Show Manipulability: false
      Show Manipulability Index: false
    Planning Request:
      All Allowed: true
      Colliding Link Color: 255; 0; 0
      Goal State Alpha: 0.8
      Goal State Color: 250; 128; 0
      Interactive Marker Size: 0.2
      Joint Violation Color: 255; 0; 255
      Planning Group: arm
      Query Goal State: false
      Query Start State: false
      Show Goal State: false
      Show Interactive Marker: false
      Show Start State: false
      Show Workspace: false
      Start State Alpha: 0.5
      Start State Color: 0; 255; 0
      Velocity Scaling Factor: 0.1
      Acceleration Scaling Factor: 0.1
    Planning Scene Topic: /monitored_planning_scene
    Robot Description: robot_description
    Scene Geometry:
      Scene Alpha: 0.8
      Scene Color: 50; 230; 50
      Scene Display Time: 0.009999999776482582
      Show Scene Geometry: false
      Voxel Coloring: Z-Axis
      Voxel Rendering: Occupied Voxels
    Scene Robot:
      Attached Body Color: 150; 50; 150
      Clear Metrics: false
      Robot Alpha: 0
      Show Additional Samples: false
      Show As Scene Geometry: false
      Show Robot Collision: false
      Show Robot Visual: false
    Trajectory:
      Display Trajectory Topic: /display_planned_path
      Interrupt Trajectory Display: false
      Loop Animation: false
      Show Robot Collision: false
      Show Robot Visual: true
      Show Trail: false
      State Display Time: 0.1
      Trail Step Size: 1
      Trajectory Alpha: 0.8
    Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: world
    Frame Rate: 10
  Name: root
  Tools:
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Interact
    Hide Inactive Objects: false
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/FocusCamera
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.6
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 0
        Y: 0
        Z: 0.35
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.51
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
      Yaw: 1.76
    Saved: null
Window Geometry:
  Displays:
    collapsed: false
  Height: 750
  Hide Left Dock: false
  Hide Right Dock: false
  Views:
    collapsed: false
  Width: 1280
  X: 60
  Y: 50
